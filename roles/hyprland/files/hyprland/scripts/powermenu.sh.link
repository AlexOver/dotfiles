#!/usr/bin/env sh
set -eu

# Entries shown in the menu
choices="Lock, Log out, Reboot, Power off, Cancel"

# Ask HyprLauncher to present a dmenu-like prompt
# If your hyprlauncher needs different flags, share `hyprlauncher --help`.
choice="$(printf "%b" | hyprlauncher -o "$choices")" || exit 0

case "$choice" in
"Lock")
  hyprlock
  ;;
"Log out")
  hyprshutdown --vt 2
  ;;
"Reboot")
  hyprshutdown -t 'Restarting...' --post-cmd 'reboot'
  ;;
"Power off")
  hyprshutdown -t 'Shutting Down...' --post-cmd 'shutdown -P 0'
  ;;
*)
  exit 0
  ;;
esac
