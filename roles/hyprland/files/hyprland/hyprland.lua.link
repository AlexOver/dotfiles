-- Hyprland configuration (Hyprland 0.55+ Lua config engine)
-- See https://wiki.hypr.land/Configuring/Start/ for reference
--
-- Structure mirrors dotfilesMothership: this file just requires each config/ module.
-- custom.lua loads early (right after variables/colors) so per-machine overrides -
-- monitor hardware, MONITOR1/MONITOR2 globals - are visible to config.binds.

require("config.variables")
require("config.colors")
require("custom")
require("config.environment")
require("config.animations")
require("config.autostart")
require("config.decorations")
require("config.inputs")
require("config.binds")
require("config.misc")
require("config.monitors")
require("config.windowrules")
require("config.workspaces")
